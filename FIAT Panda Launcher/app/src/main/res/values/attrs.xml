<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="label" format="string" />
    <attr name="unit" format="string" />

    <declare-styleable name="MetricCellView">
        <attr name="label" />
        <attr name="unit" />
        <!-- icona disegnata in codice (MetricIconView.Type), stesso ordine -->
        <attr name="icon" format="enum">
            <enum name="none" value="0" />
            <enum name="water" value="1" />
            <enum name="oil" value="2" />
            <enum name="battery" value="3" />
            <enum name="fuel" value="4" />
            <enum name="air" value="5" />
            <enum name="engine" value="6" />
            <enum name="pedal" value="7" />
            <enum name="drop" value="8" />
            <enum name="route" value="9" />
        </attr>
        <!-- valore in ambra (es. consumo istantaneo) -->
        <attr name="accent" format="boolean" />
        <!-- etichetta, valore e unità centrati (senza icona) -->
        <attr name="centered" format="boolean" />
        <!-- icona, valore e unità raggruppati al centro della casella -->
        <attr name="centerContent" format="boolean" />
        <!-- testo più largo del valore possibile (es. "000"): riserva lo spazio, così il resto non si sposta -->
        <attr name="valueTemplate" format="string" />
        <!-- testi e icona un po' più piccoli, per le caselle strette in fila -->
        <attr name="compact" format="boolean" />
        <!-- versione grande, per la pagina dell'auto e per Consumi -->
        <attr name="large" format="boolean" />
        <!-- dimensione del valore (es. 26sp), al posto di quella di compact/large; l'unità segue in proporzione -->
        <attr name="valueSize" format="dimension" />
        <!-- lato dell'icona -->
        <attr name="iconSize" format="dimension" />
    </declare-styleable>

    <declare-styleable name="ConsumptionChartView">
        <!-- scala fissa di 30 minuti con le etichette del tempo sotto -->
        <attr name="timeAxis" format="boolean" />
    </declare-styleable>
</resources>

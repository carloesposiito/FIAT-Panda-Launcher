<?xml version="1.0" encoding="utf-8"?>
<!-- Tasto di azione: contorno giallo sbiadito, si riempie appena al tocco, spento se non disponibile -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#2A313B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFC400" />
            <stroke android:width="1dp" android:color="#99FFC400" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFC400" />
            <stroke android:width="1dp" android:color="#59FFC400" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

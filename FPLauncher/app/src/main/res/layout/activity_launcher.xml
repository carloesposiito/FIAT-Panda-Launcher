<?xml version="1.0" encoding="utf-8"?>
<!-- Home: colonna app a sinistra, a destra l'area principale.
     Area principale: barra in alto (ora, data, temperatura),
     poi tre pagine (Auto 3D, Dati auto, Consumi) e in basso le frecce per cambiare pagina. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- ===================== Sinistra: app ===================== -->
    <LinearLayout
        android:layout_width="@dimen/app_column"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <!-- le app scelte, riempite dal codice; se non ci stanno tutte si scorrono in verticale
             (scorre solo questa parte: impostazioni e volume restano fermi) -->
        <ScrollView
            android:id="@+id/app_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/app_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:background="@color/line" />

        <ImageButton
            android:id="@+id/settings_button"
            style="@style/ColumnButton"
            android:contentDescription="@string/settings_button"
            android:src="@drawable/ic_round_settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:background="@color/line" />

        <!-- volume: + sopra e − sotto (tenendo premuto si ripete, sempre più veloce) -->
        <ImageButton
            android:id="@+id/volume_up"
            style="@style/ColumnButton"
            android:contentDescription="@string/volume_up"
            android:src="@drawable/ic_round_plus" />

        <ImageButton
            android:id="@+id/volume_down"
            style="@style/ColumnButton"
            android:contentDescription="@string/volume_down"
            android:src="@drawable/ic_round_minus" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/line" />

    <!-- ===================== Area principale ===================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Barra in alto, senza sfondo: data a sinistra, ora a destra; sotto un separatore -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:baselineAligned="true"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="36.5dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- giorno e data a sinistra, ora a destra -->
            <TextView
                android:id="@+id/date"
                style="@style/TileValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/clock"
                style="@style/TileValue"
                android:includeFontPadding="false"
                android:text="@string/no_value"
                android:textSize="60sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="33dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="44.5dp"
            android:background="@drawable/bg_sep_racing" />

        <!-- ===== Pagine: se ne vede una alla volta ===== -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Pagina 1: Home a tre colonne (contenuto in page_home.xml) -->
            <include
                android:id="@+id/page_car"
                layout="@layout/page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Pagina 2: foto dell'auto con i dati e gli errori letti -->
            <include
                android:id="@+id/page_car_gears"
                layout="@layout/page_car"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <!-- puntini creati dal codice, uno per pagina -->
            <LinearLayout
                android:id="@+id/page_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

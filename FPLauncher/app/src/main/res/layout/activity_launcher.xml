<?xml version="1.0" encoding="utf-8"?>
<!-- Home: colonna app a sinistra, a destra l'area principale.
     Area principale: barra in alto (ora, data, temperatura),
     poi tre pagine (Auto 3D, Dati auto, Consumi) e in basso le frecce per cambiare pagina. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- ===================== Sinistra: app ===================== -->
    <LinearLayout
        android:layout_width="@dimen/app_column"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <!-- le app scelte, riempite dal codice; se non ci stanno tutte si scorrono in verticale
             (scorre solo questa parte: impostazioni e volume restano fermi) -->
        <ScrollView
            android:id="@+id/app_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/app_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:background="@color/line" />

        <ImageButton
            android:id="@+id/settings_button"
            style="@style/ColumnButton"
            android:contentDescription="@string/settings_button"
            android:src="@drawable/ic_round_settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:background="@color/line" />

        <!-- volume: + sopra e − sotto (tenendo premuto si ripete, sempre più veloce) -->
        <ImageButton
            android:id="@+id/volume_up"
            style="@style/ColumnButton"
            android:contentDescription="@string/volume_up"
            android:src="@drawable/ic_round_plus" />

        <ImageButton
            android:id="@+id/volume_down"
            style="@style/ColumnButton"
            android:contentDescription="@string/volume_down"
            android:src="@drawable/ic_round_minus" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/line" />

    <!-- ===================== Area principale ===================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Barra in alto, senza sfondo: data a sinistra, ora a destra; sotto un separatore -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:baselineAligned="true"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="36.5dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- giorno e data a sinistra, ora a destra -->
            <TextView
                android:id="@+id/date"
                style="@style/TileValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/clock"
                style="@style/TileValue"
                android:includeFontPadding="false"
                android:text="@string/no_value"
                android:textSize="60sp" />
        </LinearLayout>

        <it.panda.launcher.ui.ShiftLightsView
            android:id="@+id/shift_lights"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="36.5dp" />

        <!-- ===== Pagine: se ne vede una alla volta ===== -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Pagina 1: Home a tre colonne (contenuto in page_home.xml) -->
            <include
                android:id="@+id/page_car"
                layout="@layout/page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Pagina 2: copia dell'Auto, con lo schema delle marce -->
            <include
                android:id="@+id/page_car_gears"
                layout="@layout/page_car"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <!-- Pagina 2: consumi. Senza riquadri: due righe di dati con separatori, poi il grafico.
                 I dati sono quelli del trip, che si azzera solo a mano. -->
            <LinearLayout
                android:id="@+id/page_trip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="25dp"
                android:paddingTop="33dp"
                android:paddingEnd="36.5dp"
                android:paddingBottom="67dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_avg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        app:centered="true"
                        app:label="@string/label_average"
                        app:large="true"
                        app:unit="@string/unit_l100" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/line_strong" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_fuel_used"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        app:centered="true"
                        app:label="@string/label_fuel_used"
                        app:large="true"
                        app:unit="@string/unit_l" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_sep_racing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_distance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        app:centered="true"
                        app:label="@string/label_distance"
                        app:large="true"
                        app:unit="@string/unit_km" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/line_strong" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        app:centered="true"
                        app:label="@string/label_time"
                        app:large="true"
                        app:unit="" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/line_strong" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_avg_speed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        app:centered="true"
                        app:label="@string/label_avg_speed"
                        app:large="true"
                        app:unit="@string/unit_kmh" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_sep_racing" />

                <!-- titolo del grafico a sinistra, azzeramento a destra -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/chart_caption" />

                    <LinearLayout
                        android:id="@+id/trip_reset"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/trip_reset"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_reset"
                            android:tint="@color/racing" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/trip_reset"
                            android:textColor="@color/muted"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>

                <it.panda.launcher.ui.ConsumptionChartView
                    android:id="@+id/consumption_chart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:timeAxis="true" />
            </LinearLayout>

            <!-- Pagina 4: navigazione da goESP. Stessi margini e stile delle altre pagine:
                 icona grande a sinistra, distanza e via a destra, sotto tre dati con separatori. -->
            <LinearLayout
                android:id="@+id/page_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="25dp"
                android:paddingTop="33dp"
                android:paddingEnd="36.5dp"
                android:paddingBottom="22dp"
                android:visibility="invisible">

                <!-- indicazione in corso -->
                <LinearLayout
                    android:id="@+id/nav_active"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="48dp">

                        <ImageView
                            android:id="@+id/nav_arrow"
                            android:layout_width="190dp"
                            android:layout_height="190dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nav_distance"
                                style="@style/TileValue"
                                android:includeFontPadding="false"
                                android:textColor="@color/accent"
                                android:textSize="72sp" />

                            <TextView
                                android:id="@+id/nav_direction"
                                android:layout_width="wrap_content"
                                android:maxWidth="460dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:ellipsize="end"
                                android:lineSpacingMultiplier="1.05"
                                android:maxLines="3"
                                android:textColor="@color/text"
                                android:textSize="34sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_sep_racing" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <it.panda.launcher.ui.MetricCellView
                            android:id="@+id/nav_cell_arrival"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:paddingStart="4dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="2dp"
                            app:centered="true"
                            app:label="@string/nav_arrival"
                            app:large="true"
                            app:unit="" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/line_strong" />

                        <it.panda.launcher.ui.MetricCellView
                            android:id="@+id/nav_cell_distance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:paddingStart="4dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="2dp"
                            app:centered="true"
                            app:label="@string/nav_remaining_distance"
                            app:large="true"
                            app:unit="" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/line_strong" />

                        <it.panda.launcher.ui.MetricCellView
                            android:id="@+id/nav_cell_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:paddingStart="4dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="2dp"
                            app:centered="true"
                            app:label="@string/nav_remaining_time"
                            app:large="true"
                            app:unit="" />
                    </LinearLayout>
                </LinearLayout>

                <!-- nessuna indicazione: stato del collegamento -->
                <LinearLayout
                    android:id="@+id/nav_idle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:alpha="0.35"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_navigation" />

                    <TextView
                        android:id="@+id/nav_idle_title"
                        style="@style/TileValue"
                        android:layout_marginTop="14dp"
                        android:text="@string/nav_idle_title"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/nav_idle_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:maxWidth="520dp"
                        android:textColor="@color/muted"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pagina 5: avvisi. Stessi margini della pagina consumi; la lista è vuota se non ci sono avvisi. -->
            <LinearLayout
                android:id="@+id/page_alerts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="25dp"
                android:paddingTop="33dp"
                android:paddingEnd="36.5dp"
                android:paddingBottom="22dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <Button
                        android:id="@+id/alerts_read"
                        style="@style/ActionButton"
                        android:text="@string/alerts_read" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <!-- riempita dal codice: una riga per avviso -->
                    <LinearLayout
                        android:id="@+id/alerts_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- puntini creati dal codice, uno per pagina -->
            <LinearLayout
                android:id="@+id/page_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

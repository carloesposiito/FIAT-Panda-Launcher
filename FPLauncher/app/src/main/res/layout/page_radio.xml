<?xml version="1.0" encoding="utf-8"?>
<!-- Pagina con l'OBD spento: solo il sintonizzatore della radio (data e ora stanno nella barra in alto, come sempre).
     Toccandola si apre l'app radio. Con l'OBD attivo non si vede: ci sono page_home.xml e page_car.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="25dp"
    android:paddingTop="20dp"
    android:paddingEnd="36.5dp"
    android:paddingBottom="22dp">

    <it.panda.launcher.ui.RadioTunerView
        android:id="@+id/home_radio_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Pagina Auto: foto dell'auto al centro, dati a sinistra (guida) e in fila sotto la foto (motore e serbatoio).
     Seconda pagina della Home, con lo schema delle marce. La prima pagina è page_home.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/tiles_left"
        android:layout_width="212dp"
        android:layout_height="match_parent"
        android:layout_marginStart="25dp"
        android:layout_marginTop="33dp"
        android:layout_marginBottom="22dp"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- tachimetro piccolo -->
        <!-- 152dp di larghezza = arco di 150dp: giri e marce sono larghi uguale -->
        <it.panda.launcher.ui.GaugeView
            android:id="@+id/speed_gauge"
            android:layout_width="152dp"
            android:layout_height="122dp"
            android:layout_gravity="center_horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_sep_racing" />

        <!-- marce: schema del cambio, con la freccia "cambia marcia" sul lato destro -->
        <FrameLayout
            android:id="@+id/gear_group"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <it.panda.launcher.ui.GearShiftView
                android:id="@+id/gear_shift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/unit_gear" />

            <ImageView
                android:id="@+id/shift_arrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:contentDescription="@string/shift_up"
                android:src="@drawable/ic_shift_up"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- zona dell'auto: foto, dati e linee in un unico riquadro largo quanto serve -->
    <FrameLayout
        android:id="@+id/car_zone"
        android:layout_width="611.5dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="237dp"
        android:layout_marginTop="33dp"
        android:layout_marginBottom="22dp">

        <!-- foto e fila di dati una sotto l'altra: la fila sta a 2,5dp dal bordo della foto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/car_image"
                android:layout_width="526dp"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/car_panda" />

            <!-- dati in una fila in basso, da davanti a dietro -->
            <LinearLayout
                android:id="@+id/car_data_row"
                android:layout_width="542dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2.5dp"
                android:layout_marginBottom="45dp"
                android:orientation="horizontal">

                <it.panda.launcher.ui.MetricCellView
                    android:id="@+id/cell_coolant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/label_coolant"
                    android:paddingStart="4dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="2.5dp"
                    app:icon="water"
                    app:centerContent="true"
                    app:compact="true"
                    app:iconSize="34dp"
                    app:large="true"
                    app:valueTemplate="000"
                    app:unit="@string/unit_celsius" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/line_strong" />

                <it.panda.launcher.ui.MetricCellView
                    android:id="@+id/cell_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/label_battery"
                    android:paddingStart="4dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="2.5dp"
                    app:icon="battery"
                    app:centerContent="true"
                    app:compact="true"
                    app:iconSize="34dp"
                    app:large="true"
                    app:valueTemplate="00,0"
                    app:unit="@string/unit_volt" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/line_strong" />

                <it.panda.launcher.ui.MetricCellView
                    android:id="@+id/cell_fuel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/label_fuel"
                    android:paddingStart="4dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="2.5dp"
                    app:icon="fuel"
                    app:centerContent="true"
                    app:compact="true"
                    app:iconSize="34dp"
                    app:large="true"
                    app:valueTemplate="000"
                    app:unit="@string/unit_percent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Home: colonna app a sinistra, a destra l'area principale.
     Area principale: barra in alto (ora, data, temperatura),
     poi tre pagine (Auto 3D, Dati auto, Consumi) e in basso le frecce per cambiare pagina. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- ===================== Sinistra: app ===================== -->
    <LinearLayout
        android:layout_width="@dimen/app_column"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <!-- riempita dal codice con quante icone ci stanno -->
        <LinearLayout
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:background="@color/line" />

        <ImageButton
            android:id="@+id/screen_off_button"
            style="@style/ColumnButton"
            android:contentDescription="@string/screen_off"
            android:src="@drawable/ic_round_screen_off" />

        <ImageButton
            android:id="@+id/settings_button"
            style="@style/ColumnButton"
            android:contentDescription="@string/settings_button"
            android:src="@drawable/ic_round_settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:background="@color/line" />

        <!-- volume: valore in un cerchio grigio traslucido (solo lettura), poi − e + (tenendo premuto si ripete) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_cell">

            <LinearLayout
                android:layout_width="@dimen/app_icon"
                android:layout_height="@dimen/app_icon"
                android:layout_gravity="center"
                android:background="@drawable/bg_volume_value"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/volume_value"
                    style="@style/TileValue"
                    android:alpha="0.75"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/no_value"
                    android:textColor="@color/muted"
                    android:textSize="28sp" />
            </LinearLayout>
        </FrameLayout>

        <ImageButton
            android:id="@+id/volume_down"
            style="@style/ColumnButton"
            android:contentDescription="@string/volume_down"
            android:src="@drawable/ic_round_minus" />

        <ImageButton
            android:id="@+id/volume_up"
            style="@style/ColumnButton"
            android:contentDescription="@string/volume_up"
            android:src="@drawable/ic_round_plus" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/line" />

    <!-- ===================== Area principale ===================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Barra in alto: data a sinistra, ora a destra -->
        <LinearLayout
            style="@style/Tile"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp">

            <!-- giorno e data a sinistra, ora a destra -->
            <TextView
                android:id="@+id/date"
                style="@style/TileValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="33sp" />

            <TextClock
                android:id="@+id/clock"
                style="@style/TileValue"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textSize="36sp" />
        </LinearLayout>

        <!-- ===== Pagine: se ne vede una alla volta ===== -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Pagina 1: foto dell'auto al centro, dati a sinistra (guida) e a destra (motore e serbatoio) -->
            <FrameLayout
                android:id="@+id/page_car"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/tiles_left"
                    android:layout_width="212dp"
                    android:foreground="@drawable/debug_border_red"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="22dp"
                    android:orientation="vertical">

                    <!-- tachimetro piccolo -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:foreground="@drawable/debug_border_cyan"
                        android:layout_weight="1"
                        android:padding="4dp">

                        <it.panda.launcher.ui.GaugeView
                            android:id="@+id/speed_gauge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/line_strong" />

                    <!-- giri: numero, grafico degli ultimi secondi e barra a tacche; largo quanto l'arco del tachimetro -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/rpm_group"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:foreground="@drawable/debug_border_cyan"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/rpm_value"
                                    style="@style/TileValue"
                                    android:includeFontPadding="false"
                                    android:text="@string/no_value"
                                    android:textSize="30sp" />

                                <TextView
                                    style="@style/TileUnit"
                                    android:layout_gravity="bottom"
                                    android:text="@string/unit_rpm" />
                            </LinearLayout>

                            <it.panda.launcher.ui.SparklineView
                                android:id="@+id/rpm_spark"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="6dp" />

                            <it.panda.launcher.ui.SegmentBarView
                                android:id="@+id/rpm_bar"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- marce: schema del cambio, con la freccia "cambia marcia" sul lato destro -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <FrameLayout
                            android:id="@+id/gear_group"
                            android:layout_width="140dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_horizontal"
                            android:foreground="@drawable/debug_border_cyan">

                            <it.panda.launcher.ui.GearShiftView
                                android:id="@+id/gear_shift"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/unit_gear" />

                            <ImageView
                                android:id="@+id/shift_arrow"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="end|bottom"
                                android:contentDescription="@string/shift_up"
                                android:src="@drawable/ic_shift_up"
                                android:visibility="gone" />
                        </FrameLayout>
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/line_strong" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_instant_car"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:foreground="@drawable/debug_border_cyan"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        app:label="@string/label_instant"
                        app:large="true"
                        app:unit="@string/unit_l100" />

                </LinearLayout>

                <!-- zona dell'auto: foto, dati e linee in un unico riquadro largo quanto serve -->
                <FrameLayout
                    android:id="@+id/car_zone"
                    android:layout_width="611.5dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginStart="237dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="22dp"
                    android:foreground="@drawable/debug_border_white">

                    <ImageView
                        android:id="@+id/car_image"
                        android:layout_width="526dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="71.5dp"
                        android:layout_marginTop="54dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="98dp"
                        android:contentDescription="@string/app_name"
                        android:foreground="@drawable/debug_border_green"
                        android:scaleType="fitStart"
                        android:src="@drawable/car_panda" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_battery"
                        android:layout_width="150dp"
                        android:layout_height="64dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="104dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/label_battery"
                        android:foreground="@drawable/debug_border_yellow"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        app:icon="battery"
                        app:iconSize="52dp"
                        app:large="true"
                        app:unit="@string/unit_volt" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_coolant"
                        android:layout_width="150dp"
                        android:layout_height="64dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="24dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/label_coolant"
                        android:foreground="@drawable/debug_border_yellow"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        app:icon="water"
                        app:iconSize="52dp"
                        app:large="true"
                        app:unit="@string/unit_celsius" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_fuel"
                        android:layout_width="176dp"
                        android:layout_height="64dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="358dp"
                        android:layout_marginBottom="24dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/label_fuel"
                        android:foreground="@drawable/debug_border_yellow"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        app:icon="fuel"
                        app:iconSize="52dp"
                        app:large="true"
                        app:unit="@string/unit_percent" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_oil"
                        android:layout_width="176dp"
                        android:layout_height="64dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="82dp"
                        android:layout_marginBottom="24dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/label_oil"
                        android:foreground="@drawable/debug_border_yellow"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        app:icon="oil"
                        app:iconSize="52dp"
                        app:large="true"
                        app:unit="@string/unit_celsius" />

                    <!-- linee dai dati alla zona dell'auto -->
                    <it.panda.launcher.ui.CalloutLinesView
                        android:id="@+id/callouts"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </FrameLayout>

            <!-- Pagina 3: consumi. Schede e caselle in alto, grafico grande sotto -->
            <LinearLayout
                android:id="@+id/page_trip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/tab_drive"
                        style="@style/ViewToggle"
                        android:layout_height="36dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/tab_drive"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/tab_trip"
                        style="@style/ViewToggle"
                        android:layout_height="36dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/tab_trip"
                        android:textSize="15sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/trip_reset"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/trip_reset"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_reset" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_instant"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:accent="true"
                        app:label="@string/label_instant"
                        app:large="true"
                        app:unit="@string/unit_l100" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_avg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:label="@string/label_average"
                        app:large="true"
                        app:unit="@string/unit_l100" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_distance"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:label="@string/label_distance"
                        app:large="true"
                        app:unit="@string/unit_km" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_time"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:label="@string/label_time"
                        app:large="true"
                        app:unit="" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_avg_speed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:label="@string/label_avg_speed"
                        app:large="true"
                        app:unit="@string/unit_kmh" />

                    <it.panda.launcher.ui.MetricCellView
                        android:id="@+id/cell_fuel_used"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:label="@string/label_fuel_used"
                        app:large="true"
                        app:unit="@string/unit_l" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Tile"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="6dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="@string/chart_caption" />

                    <it.panda.launcher.ui.ConsumptionChartView
                        android:id="@+id/consumption_chart"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1"
                        app:timeAxis="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pagina 4: navigazione da goESP. Freccia grande e distanza a sinistra, via e dati a destra -->
            <LinearLayout
                android:id="@+id/page_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:visibility="invisible">

                <!-- indicazione in corso -->
                <LinearLayout
                    android:id="@+id/nav_active"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/Tile"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/nav_arrow"
                                android:layout_width="170dp"
                                android:layout_height="170dp"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/nav_distance"
                                style="@style/TileValue"
                                android:layout_marginTop="4dp"
                                android:includeFontPadding="false"
                                android:textColor="@color/accent"
                                android:textSize="44sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/nav_direction"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:lineSpacingMultiplier="1.05"
                            android:maxLines="4"
                            android:textColor="@color/text"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <it.panda.launcher.ui.MetricCellView
                            android:id="@+id/nav_cell_arrival"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            app:label="@string/nav_arrival"
                            app:large="true"
                            app:unit="" />

                        <it.panda.launcher.ui.MetricCellView
                            android:id="@+id/nav_cell_distance"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            app:label="@string/nav_remaining_distance"
                            app:large="true"
                            app:unit="" />

                        <it.panda.launcher.ui.MetricCellView
                            android:id="@+id/nav_cell_time"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            app:label="@string/nav_remaining_time"
                            app:large="true"
                            app:unit="" />
                    </LinearLayout>
                </LinearLayout>

                <!-- nessuna indicazione: stato del collegamento -->
                <LinearLayout
                    android:id="@+id/nav_idle"
                    style="@style/Tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:alpha="0.35"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_navigation" />

                    <TextView
                        android:id="@+id/nav_idle_title"
                        style="@style/TileValue"
                        android:layout_marginTop="14dp"
                        android:text="@string/nav_idle_title"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/nav_idle_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:maxWidth="520dp"
                        android:textColor="@color/muted"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pagina 5: avvisi e diagnosi (spia motore, codici di errore, avvisi dai valori) -->
            <LinearLayout
                android:id="@+id/page_alerts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:visibility="invisible">

                <LinearLayout
                    style="@style/Tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/alerts_summary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/alerts_read"
                            style="@style/ActionButton"
                            android:text="@string/alerts_read" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <!-- riempita dal codice: una riga per avviso -->
                        <LinearLayout
                            android:id="@+id/alerts_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <TextView
                        style="@style/TileSub"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/alerts_note" />
                </LinearLayout>
            </LinearLayout>

            <!-- puntini creati dal codice, uno per pagina -->
            <LinearLayout
                android:id="@+id/page_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

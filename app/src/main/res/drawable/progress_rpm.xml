<?xml version="1.0" encoding="utf-8"?>
<!-- Barra dei giri: fondo scuro e riempimento ambra. La zona rossa (da 6000 rpm) è una View separata nel layout. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#1D2128" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="#B8742A" android:endColor="@color/accent" />
                <corners android:radius="5dp" />
            </shape>
        </clip>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tasto tondo: grigio scuro, ambra quando è selezionato -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval"><solid android:color="@color/accent" /></shape>
    </item>
    <item>
        <ripple android:color="#33FFFFFF">
            <item><shape android:shape="oval"><solid android:color="@color/panel" /></shape></item>
        </ripple>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tasto di azione: contorno giallo, si riempie al tocco, spento se non disponibile -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#3A4350" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFC400" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFC400" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

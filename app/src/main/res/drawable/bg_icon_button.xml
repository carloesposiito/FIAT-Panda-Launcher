<?xml version="1.0" encoding="utf-8"?>
<!-- Tasto rotondo con icona: selezionato = alone giallo -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="oval">
                    <solid android:color="#26FFC400" />
                    <stroke android:width="1dp" android:color="#99FFC400" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#D9141922" />
                    <stroke android:width="1dp" android:color="@color/line" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

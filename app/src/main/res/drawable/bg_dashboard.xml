<?xml version="1.0" encoding="utf-8"?>
<!-- Sfondo del cruscotto: trama a fibra di carbonio, luce morbida al centro e bordi che scuriscono -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/bg_carbon"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.45"
                android:endColor="#00000000"
                android:gradientRadius="55%p"
                android:startColor="#3326303C"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#B3000000"
                android:gradientRadius="85%p"
                android:startColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
